<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
<meta content="de" http-equiv="Content-Language" />
<meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
<title>Patientenübersicht</title>
<style type="text/css">html,
body {
  font-family: Segoe UI;
  font-size: 13px;
}

h1 {
  font-family: Segoe UI Light, Segoe UI;
  font-size: 24pt;
  font-weight: 300;
  margin: 5px;
}

h2 {
  font-family: Segoe UI Light, Segoe UI;
  font-size: 20pt;
  font-weight: 300;
  margin-bottom: 0px;
}

h3 {
  font-family: Segoe UI Light, Segoe UI;
  font-size: 18pt;
  font-weight: 300;
}

h4 {
  font-family: Segoe UI;
  font-size: 16pt;
  font-weight: 300;
}

h4 {
  font-family: Segoe UI;
  font-size: 14pt;
  font-weight: 500;
}



a {
 padding: 5px;
  color:#3399FF;
 text-decoration: none;
}

a:hover {
 text-decoration: none;
}


table
{	
border-collapse: collapse;
width:100%;
 border: 1px solid #ddd;
}

.bordered td{
 border: 1px solid #ddd;
 padding: 5px;
}

td {
border-bottom: 1px solid #ddd;
padding: 5px;
}

th {
border-bottom: 1px solid black;
padding: 5px;
text-align: left;
font-family: Segoe UI Light;
font-size: 14px;
font-weight: 300;
color: #0061C1;
background: #FBFBFB;
}

.bordered th {
 border: 1px solid #ddd;
padding: 5px;
text-align: left;
}

.noborder th,.noborder td {
 border: 0px;
padding: 5px;
text-align: left;
}


</style>

</head>

<body>
<h1>Einsatzbericht Sandienst</h1>

<h2>Zusammenfassung</h2>
<table class="table bordered">
<tr>   
      <th class="text-left">Behandelt</th>
      <th class="text-left">Transportiert</th>
</tr>
<tr>  
      <td class="text-left">
{sql}SELECT COUNT(*) FROM PATIENTEN WHERE PATIENTEN.ADDTIME BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND PATIENTEN.IST_ENTLASSEN = 1;{/sql}
     </td>
      <td class="text-left">
{sql}SELECT COUNT(*) FROM PATIENTEN WHERE PATIENTEN.ADDTIME BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND PATIENTEN.IST_ENTLASSEN = 0;{/sql}
     </td>
</tr>
</table>

<h2>Patientenliste</h2>
<table class="table bordered">
	<tr>   
      <th class="text-left">Einsatz</th>
      <th class="text-left">Erfasst</th>
      <th class="text-left">Nr.</th>	
      <th class="text-left">Name / Vorname</th>
	  <th class="text-left">Geschlecht</th>
      <th class="text-left">Alter</th>
      <th class="text-left">Verletzungen</th>
      <th class="text-left">Fundort</th>
      <th class="text-left">Kind</th>
      <th class="text-left">Einheit</th>
      <th class="text-left">Ziel</th>
      <th class="text-left">Entlassen</th>
    </tr>

    
      {sql}SELECT PATIENTEN.*, patienten.em as RUFNAME from PATIENTEN WHERE PATIENTEN.ADDTIME BETWEEN ' <%BEGINN%>' AND '<%ENDE%>' order by PATIENTEN.UHS_PATNUMMER asc |
         	<tr>  
          <td class="text-left">%EINSATZNUMMER%</td>
          <td class="text-left">%ADDTIME%</td>
	  <td class="text-left" 
	  {if}"%SICHTUNGSKATEGORIE%"=="Rot"{then} style="background:#FF7D7D"{endif}
	  {if}"%SICHTUNGSKATEGORIE%"=="Gelb"{then} style="background:#FFFF9B"{endif}
	  {if}"%SICHTUNGSKATEGORIE%"=="Grün"{then} style="background:#9FFF9F"{endif}
	  {if}"%SICHTUNGSKATEGORIE%"=="Tot"{then} style="background:#949494"{endif}
	  {if}"%SICHTUNGSKATEGORIE%"=="Blau"{then} style="background:#8AC5FF"{endif}><b>%UHS_PATNUMMER%</b></td>			
      <td class="text-left">%NAME%, </br> %VORNAME%</td>
      <td class="text-left">%GESCHLECHT%</td>
	  <td class="text-left">%PAT_ALTER%</td>
      <td class="text-left">%VERLETZUNG%</td>
      <td class="text-left">%KOMMENTAR%</td>
      <td class="text-left">{if}"%Ist_Kind%"=="1"{then}<img src="data:image/png;base64," width="32" height="32"/> {endif} {if}"%Ist_Kind%"<>"1"{then} {endif}</td>
      <td class="text-left">%EM% </br> %EM2%</td>
      <td class="text-left">%ZIELORT%</td>
      <td class="text-left">{if}"%Ist_Entlassen%"=="1"{then} <img src="data:image/png;base64," width="32" height="32"/> {endif} {if}"%Ist_Entlassen%"<>"1"{then}  {endif}</td>
    </tr>
{/sql}
</table>

<p><b>
<span style="color: #C40000">Rot: </span>
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Rot'; {/sql}| 
<span style="color: #E8E800">Gelb: </span>
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Gelb'; {/sql}| 
<span style="color: #00D900">Grün: </span>
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Grün'; {/sql}| 
Tot: 
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Schwarz'; {/sql}| 
<span style="color: #D4D4D4">Betroffen: </span>
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Unverletzt'; {/sql}| 
<span style="color: #D4D4D4">Ungesichtet: </span>
{sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>' AND SICHTUNGSKATEGORIE LIKE 'Ungesichtet'; {/sql} 
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
Gesamt: {sql}SELECT COUNT(*) FROM PATIENTEN JOIN EINSAETZE ON PATIENTEN.EINSATZNUMMER = EINSAETZE.EINSATZNUMMER WHERE EINSAETZE.EROEFF BETWEEN '<%BEGINN%>' and '<%ENDE%>'; {/sql}</b></p>

</body>

